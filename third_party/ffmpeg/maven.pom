  <artifactId>ffmpeg-kit-https</artifactId>
  <version>7.1.6</version>
  <packaging>aar</packaging>
  <name>FFmpegKit Https</name>
  <description>Actively maintained continuation of com.arthenica:ffmpeg-kit-https (retired, archived April 2025). Same com.arthenica.ffmpegkit API, drop-in replacement -- just change the groupId. TLS/https:// URL support (gmp+gnutls), Android SDK 35, 16 KB page size, security-tracked. By Jokobee -- jokobee.com</description>
  <url>https://github.com/ffmpegkit-maintained/ffmpeg/releases</url>
  <inceptionYear>2026</inceptionYear>
